                                                   566 ***********************************************************************
                                                   567 *        Issue HERCULES MESSAGE pointed to by R1, length in R0
                                                   568 *              R2 = return address
                                                   569 ***********************************************************************

000006B0  4900 85E4                     000007E4   571 MSG      CH    R0,=H'0'               Do we even HAVE a message?
000006B4  07D2                                     572          BNHR  R2                     No, ignore

000006B6  9002 84EC                     000006EC   574          STM   R0,R2,MSGSAVE          Save registers

000006BA  4900 85E6                     000007E6   576          CH    R0,=AL2(L'MSGMSG)      Message length within limits?
000006BE  47D0 84C6                     000006C6   577          BNH   MSGOK                  Yes, continue
000006C2  4100 0064                     00000064   578          LA    R0,L'MSGMSG            No, set to maximum

000006C6  1820                                     580 MSGOK    LR    R2,R0                  Copy length to work register
000006C8  0620                                     581          BCTR  R2,0                   Minus-1 for execute
000006CA  4420 84F8                     000006F8   582          EX    R2,MSGMVC              Copy message to O/P buffer

000006CE  4120 200A                     0000000A   584          LA    R2,1+L'MSGCMD(,R2)     Calculate true command length
000006D2  4110 84FE                     000006FE   585          LA    R1,MSGCMD              Point to true command

000006D6  83120008                                 587          DC    X'83',X'12',X'0008'    Issue Hercules Diagnose X'008'
000006DA  4780 84E6                     000006E6   588          BZ    MSGRET                 Return if successful
                                                   589
000006DE  1222                                     590          LTR   R2,R2                  Is Diag8 Ry (R2) 0?
000006E0  4780 84E6                     000006E6   591          BZ    MSGRET                   an error occurred but coninue
                                                   592
000006E4  0000                                     593          DC    H'0'                   CRASH for debugging purposes

000006E6  9802 84EC                     000006EC   595 MSGRET   LM    R0,R2,MSGSAVE          Restore registers
000006EA  07F2                                     596          BR    R2                     Return to caller







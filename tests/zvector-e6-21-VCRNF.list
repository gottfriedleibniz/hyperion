                                                   515 ***********************************************************************
                                                   516 *        Issue HERCULES MESSAGE pointed to by R1, length in R0
                                                   517 *              R2 = return address
                                                   518 ***********************************************************************

00000638  4900 8558                     00000758   520 MSG      CH    R0,=H'0'               Do we even HAVE a message?
0000063C  07D2                                     521          BNHR  R2                     No, ignore

0000063E  9002 8474                     00000674   523          STM   R0,R2,MSGSAVE          Save registers

00000642  4900 855A                     0000075A   525          CH    R0,=AL2(L'MSGMSG)      Message length within limits?
00000646  47D0 844E                     0000064E   526          BNH   MSGOK                  Yes, continue
0000064A  4100 0064                     00000064   527          LA    R0,L'MSGMSG            No, set to maximum

0000064E  1820                                     529 MSGOK    LR    R2,R0                  Copy length to work register
00000650  0620                                     530          BCTR  R2,0                   Minus-1 for execute
00000652  4420 8480                     00000680   531          EX    R2,MSGMVC              Copy message to O/P buffer

00000656  4120 200A                     0000000A   533          LA    R2,1+L'MSGCMD(,R2)     Calculate true command length
0000065A  4110 8486                     00000686   534          LA    R1,MSGCMD              Point to true command

0000065E  83120008                                 536          DC    X'83',X'12',X'0008'    Issue Hercules Diagnose X'008'
00000662  4780 846E                     0000066E   537          BZ    MSGRET                 Return if successful
                                                   538
00000666  1222                                     539          LTR   R2,R2                  Is Diag8 Ry (R2) 0?
00000668  4780 846E                     0000066E   540          BZ    MSGRET                   an error occurred but coninue
                                                   541
0000066C  0000                                     542          DC    H'0'                   CRASH for debugging purposes

0000066E  9802 8474                     00000674   544 MSGRET   LM    R0,R2,MSGSAVE          Restore registers
00000672  07F2                                     545          BR    R2                     Return to caller






